generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  SOLD
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  assets       Asset[]

  @@map("users")
}

model Asset {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  name               String
  category           String
  brand              String?
  modelNumber       String?               @map("model_number")
  serialNumber      String?               @map("serial_number")
  purchaseDate      DateTime?             @map("purchase_date") @db.Date
  purchasePrice     Decimal?              @map("purchase_price") @db.Decimal(12, 2)
  warrantyEndDate   DateTime?             @map("warranty_end_date") @db.Date
  qrCodeId          String                @unique @default(uuid()) @map("qr_code_id") @db.Uuid
  location          String?
  photoUrl          String?               @map("photo_url")
  status            AssetStatus           @default(ACTIVE)
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRecords    ServiceRecord[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([userId])
  @@index([status])
  @@map("assets")
}

model ServiceRecord {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  serviceDate    DateTime @map("service_date") @db.Date
  serviceType    String   @map("service_type")
  title          String
  description    String?
  technicianName String?  @map("technician_name")
  serviceProvider String? @map("service_provider")
  cost           Decimal? @db.Decimal(12, 2)
  invoiceUrl     String?  @map("invoice_url")
  replacedComponents String? @map("replaced_components")
  createdAt      DateTime @default(now()) @map("created_at")
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([serviceDate])
  @@map("service_records")
}

model MaintenanceSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  title             String
  description       String?
  nextDueDate       DateTime @map("next_due_date") @db.Date
  repeatEveryMonths Int?     @map("repeat_every_months")
  reminderDaysBefore Int     @default(7) @map("reminder_days_before")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([nextDueDate])
  @@map("maintenance_schedules")
}

